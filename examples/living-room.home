// Living-room comfort: declarations plus AND / OR
ROOM LIVING_ROOM;
DEVICE LAMP : LIGHT IN LIVING_ROOM;
DEVICE CEILING_FAN : FAN IN LIVING_ROOM;
SENSOR LUX : LIGHT_SENSOR IN LIVING_ROOM;
SENSOR HUM : HUMIDITY_SENSOR IN LIVING_ROOM UNIT %;
SENSOR PIR : MOTION_SENSOR IN LIVING_ROOM;

IF PIR IS DETECTED AND LUX < 50LUX AND NOT TIME BETWEEN 01:00 AND 05:00 THEN
    SET LAMP BRIGHTNESS TO 70%
ELSE
    TURN_OFF LAMP
END;

IF HUM >= 70% OR (PIR IS DETECTED AND HUM > 60%) THEN SET CEILING_FAN SPEED TO 3 ELSE TURN_OFF CEILING_FAN END;

SIMULATE FROM 18:00 TO 19:00 STEP 1MIN {
    AT 18:00: LUX = 200LUX, PIR = CLEAR, HUM = 55%;
    AT 18:10: PIR = DETECTED;
    AT 18:20: LUX = 30LUX;
    AT 18:30: HUM = 72%;
    AT 18:45: PIR = CLEAR, HUM = 58%;
}
