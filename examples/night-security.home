// Night security: a time window that crosses midnight
ROOM ENTRANCE;
ROOM HALL;

DEVICE FRONT_DOOR  : DOOR_LOCK IN ENTRANCE;
DEVICE PORCH_LIGHT : LIGHT     IN ENTRANCE;
DEVICE HALL_LIGHT  : LIGHT     IN HALL;

SENSOR DOOR_CONTACT : CONTACT_SENSOR  IN ENTRANCE;
SENSOR HALL_PIR     : MOTION_SENSOR   IN HALL;
SENSOR OWNER        : PRESENCE_SENSOR IN ENTRANCE;

RULE "Lock up at night":
IF TIME BETWEEN 23:00 AND 06:00 AND DOOR_CONTACT IS CLOSED THEN
    LOCK FRONT_DOOR
ELSE
    IF OWNER IS HOME THEN UNLOCK FRONT_DOOR END
END;

RULE "Porch light after dark":
IF TIME BETWEEN 19:00 AND 05:30 THEN
    SET PORCH_LIGHT BRIGHTNESS TO 40%
ELSE
    TURN_OFF PORCH_LIGHT
END;

RULE "Hall night light" PRIORITY 2:
WHEN HALL_PIR DETECTED IF TIME BETWEEN 22:00 AND 06:00 THEN
    SET HALL_LIGHT BRIGHTNESS TO 15%, WAIT 3MIN, TURN_OFF HALL_LIGHT
END;

SIMULATE FROM 22:00 TO 06:30 STEP 1MIN {
    AT 22:00: OWNER = HOME, DOOR_CONTACT = CLOSED, HALL_PIR = CLEAR;
    AT 22:30: HALL_PIR = DETECTED;
    AT 22:32: HALL_PIR = CLEAR;
    AT 02:15: HALL_PIR = DETECTED;
    AT 02:16: HALL_PIR = CLEAR;
}
