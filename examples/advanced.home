// Advanced: bedroom comfort + security
ROOM BEDROOM; ROOM LIVING_ROOM; ROOM ENTRANCE;

DEVICE AC         : AIR_CONDITIONER IN BEDROOM;
DEVICE BED_LIGHT  : LIGHT           IN BEDROOM;
DEVICE FAN        : FAN             IN LIVING_ROOM;
DEVICE FRONT_DOOR : DOOR_LOCK       IN ENTRANCE;
DEVICE CURTAIN    : CURTAIN         IN BEDROOM;

SENSOR TEMP   : TEMP_SENSOR     IN BEDROOM UNIT C;
SENSOR MOTION : MOTION_SENSOR   IN BEDROOM;
SENSOR OWNER  : PRESENCE_SENSOR IN ENTRANCE;

RULE "Cool bedroom" PRIORITY 2:
IF TEMP > 86F AND (MOTION IS DETECTED OR TIME BETWEEN 22:00 AND 06:00) FOR 2MIN THEN
    TURN_ON AC, SET AC TEMPERATURE TO 24C
ELSE
    TURN_OFF AC
END;

RULE "Night light":
WHEN MOTION DETECTED IF TIME BETWEEN 22:00 AND 06:00 THEN
    SET BED_LIGHT BRIGHTNESS TO 20%, WAIT 5MIN, TURN_OFF BED_LIGHT
END;

RULE "Morning":
AT 07:00 ON WEEKDAYS THEN OPEN CURTAIN, NOTIFY "Good morning!" END;

RULE "Leaving home" PRIORITY 5:
WHEN OWNER CHANGES IF OWNER IS AWAY THEN
    LOCK FRONT_DOOR, TURN_OFF AC, TURN_OFF FAN, NOTIFY "Home secured"
END;

SIMULATE FROM 21:30 TO 07:30 STEP 1MIN {
    AT 21:30: TEMP = 29C, MOTION = CLEAR, OWNER = HOME;
    AT 22:10: MOTION = DETECTED;
    AT 22:15: TEMP = 31C;
    AT 23:00: MOTION = CLEAR;
    AT 07:15: OWNER = AWAY;
}
