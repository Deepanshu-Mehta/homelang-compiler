{
  "name": "homelang",
  "version": "1.0.0",
  "description": "A complete compiler for a smart-home automation language, with a live phase-by-phase visual walkthrough.",
  "type": "module",
  "private": true,
  "bin": {
    "homelang": "./dist-cli/homelang.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/homelang.ts --bundle --platform=node --format=esm --outfile=dist-cli/homelang.js --log-level=warning",
    "preview": "vite preview",
    "homelang": "tsx src/cli/homelang.ts",
    "ll1": "tsx scripts/ll1.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "d3-hierarchy": "^3.1.2",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-dagre": "^2.3.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
